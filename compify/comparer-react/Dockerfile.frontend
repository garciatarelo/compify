# Stage 1: Construcción de la aplicación React con Vite
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Inyectar la variable de entorno para que las llamadas a la API apunten a /api
# Esto permite que el proxy inverso de Nginx intercepte y enrute al backend
ENV VITE_API_URL=/api

RUN npm run build

# Stage 2: Servidor Nginx
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
